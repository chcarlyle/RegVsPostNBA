data$vorp <- round((data$bpm + 2) * (data$seconds / data$total), 1)
data$year <- year
current_data <- get(paste0(team, 'r'))
updated_data <- bind_rows(current_data, data)
assign(paste0(team, 'r'), updated_data, envir = .GlobalEnv)
}
print(paste0("Regular Season ", j," of ", length(listr) ,": ", round(i / nrow(listr[[j]]) * 100, 2), "% complete"))
Sys.sleep(2)
}
}
for (j in seq_along(listp)) {
for (i in seq_len(nrow(listp[[j]]))) {
id <- listp[[j]]$id[i]
year <- listp[[j]]$year[i]
url <- paste0("https://www.basketball-reference.com/boxscores/", id, ".html")
webpage <- read_html(url)
# Extract the table rows
rows <- html_nodes(webpage, paste0("table#box-", abbrev, "-game-advanced tbody tr"))
total_node <- html_node(webpage, paste0("table#box-", abbrev, "-game-advanced tfoot tr td[data-stat='mp']"))
total <- if (!is.null(total_node)) as.numeric(html_text(total_node)) * 12 else NA
# Apply the function to each row
datap <- bind_rows(lapply(rows, extract_data, total = total))
# Ensure the data frame has the correct structure
datap$bpm <- as.numeric(datap$bpm)
datap$seconds <- as.numeric(datap$seconds)
# Handle cases where seconds or bpm might be NA
datap <- datap[!is.na(datap$seconds) & !is.na(datap$bpm) & !is.na(datap$total), ]
if (nrow(datap) > 0) {
datap$vorp <- round((datap$bpm + 2) * (datap$seconds / datap$total), 1)
datap$year <- year
current_data <- get(paste0(team, 'p'))
updated_data <- bind_rows(current_data, datap)
assign(paste0(team, 'p'), updated_data, envir = .GlobalEnv)
}
print(paste0("Postseason ", j," of ", length(listp) ,": ", round(i / nrow(listp[[j]]) * 100, 2), "% complete"))
Sys.sleep(2)
}
}
}
