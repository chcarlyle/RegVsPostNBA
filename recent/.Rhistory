ggplot(avg_temp) +
geom_point(aes(x = year, y = avg_TVORP, color = type)) +
geom_line(aes(x = year, y = avg_TVORP, color = type)) +
labs(
title = titles,
x = 'Year',
y = 'Average Time Adjusted VORP',
subtitle = 'Regular Season vs Post Season Average Adjusted VORP'
) +
scale_color_manual(
name = 'Time',
values = c('reg' = '#0072B2', 'post' = '#D55E00')
) +
scale_x_continuous(breaks = seq(min(avg_temp$year), max(avg_temp$year), by = 1)) +
ylim(-10, 17)
}
player1('tatumja01',celtics)
player1('brownja02',celtics)
