test <- function(player, team){
assign(player,team[team$player==player,])
assign(paste0(player,'reg'), get(player)[get(player)$type=='regular',]$vorp)
assign(paste0(player,'post'), get(player)[get(player)$type=='post',]$vorp)
plot(density(get(paste0(player,'reg'))), ylim=c(0,0.12),xlim=c(-25,25))
lines(density(get(paste0(player,'post'))),col='red')
abline(v = mean(get(paste0(player,'reg'))))
abline(v = mean(get(paste0(player,'post'))), col='red')
t.test(get(paste0(player,'reg')), get(paste0(player,'post')))
}
