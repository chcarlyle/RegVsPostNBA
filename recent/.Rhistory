player1 <- function(play, team, titles = "Player Performance") {
temp <- filter(team, player == play)
minyear <- min(temp$year)
# Calculate the average TVORP for each regular and postseason
avg_temp <- temp %>%
group_by(year, type) %>%
summarise(avg_TVORP = mean(vorp, na.rm = TRUE))
ggplot(avg_temp) +
geom_point(aes(x = year, y = avg_TVORP, color = time)) +
geom_line(aes(x = year, y = avg_TVORP, color = time)) +
labs(
title = titles,
x = 'Year',
y = 'Average Time Adjusted VORP',
subtitle = 'Regular Season vs Post Season Average Adjusted VORP'
) +
scale_color_manual(
name = 'Time',
values = c('regular' = '#0072B2', 'postseason' = '#D55E00')
) +
scale_x_continuous(breaks = seq(min(avg_temp$year), max(avg_temp$year), by = 1)) +
ylim(-10, 17)
}
player1('embiijo01',sixers)
names(sixers)
